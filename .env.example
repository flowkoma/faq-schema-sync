# The ONLY required variable. Protects the admin UI (/) and admin API (/api/*).
# All Webflow tokens, collection IDs, and field slugs are entered per site
# through the UI and stored in DATA_DIR/sites.json.
# Generate with: openssl rand -hex 16
ADMIN_PASSWORD=

# Where site configs are persisted. On Railway: attach a volume mounted at
# /data and set DATA_DIR=/data so configs survive redeploys.
# DATA_DIR=./data

# Explicit public base URL for webhook registration, e.g.
# https://your-app.up.railway.app — usually unnecessary (derived from the
# request's forwarded headers).
# PUBLIC_URL=

# --- Tuning (defaults are sensible; override only if needed) ---
# DEBOUNCE_MS=12000
# API_SPACING_MS=1100
# MAX_WEBHOOK_AGE_MS=300000
# PORT=3000
